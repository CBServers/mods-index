{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/CBServers/mods-index/schema/entry.schema.json",
    "title": "CB Servers mod index entry",
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "type", "name", "author", "description"],
    "properties": {
        "$schema": { "type": "string" },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
        "type": { "enum": ["map", "mod"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "author": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "images": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}\\.(jpg|jpeg|png)$" }
        },
        "requires": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" }
        },
        "files": {
            "type": "array",
            "items": { "$ref": "#/$defs/file" }
        }
    },
    "$defs": {
        "url": { "type": "string", "pattern": "^(https://|cdn:)" },
        "file": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size"],
            "oneOf": [
                { "required": ["url"], "not": { "required": ["parts"] } },
                { "required": ["parts"], "not": { "required": ["url"] } }
            ],
            "properties": {
                "root": { "enum": ["game", "storage"] },
                "path": { "type": "string", "minLength": 1, "maxLength": 200 },
                "size": { "type": "integer", "minimum": 0 },
                "url": { "$ref": "#/$defs/url" },
                "parts": {
                    "type": "array",
                    "minItems": 2,
                    "items": { "$ref": "#/$defs/url" }
                },
                "hash": { "type": "string", "pattern": "^[0-9A-F]{16}$" }
            }
        }
    }
}
